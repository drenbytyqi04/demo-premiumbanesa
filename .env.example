# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Without these the site runs in demo mode (JSON data; admin changes kept only in that browser).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_…). The legacy anon key also works via VITE_SUPABASE_ANON_KEY.
# NEVER put the service-role / secret key in any VITE_ variable – it would be shipped to every visitor.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key

# Demo mode only (no Supabase): login for #/admin. NOT secure – anyone can read it from the JS bundle.
VITE_DEMO_ADMIN_EMAIL=admin@demo.local
VITE_DEMO_ADMIN_PASSWORD=aurora-demo
