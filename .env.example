# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Without these the site runs in demo mode (changes are kept only in the admin's own browser).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Demo mode only (no Supabase): login for #/admin. NOT secure – anyone can read it from the JS bundle.
VITE_DEMO_ADMIN_EMAIL=admin@demo.local
VITE_DEMO_ADMIN_PASSWORD=aurora-demo
